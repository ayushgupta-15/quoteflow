# Postgres connection string. Local dev uses the private cluster started by scripts/local-db.sh.
DATABASE_URL=postgres://quoteflow:quoteflow@localhost:54329/quoteflow
# Random string, 32+ characters, used to sign session cookies.
SESSION_SECRET=
# Optional: enables LLM-assisted extraction of free-text RFQ emails.
# Without it the rule-based extractor is used and the UI says so.
ANTHROPIC_API_KEY=
